# Provider AI: ollama (locale, gratis) oppure openai (richiede API key)
# Se lasci PROVIDER vuoto: usa openai quando OPENAI_API_KEY è impostata, altrimenti ollama
PROVIDER=ollama

# Da compilare quando avrai la chiave (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Opzionali (questi sono i default)
# OPENAI_LLM_MODEL=gpt-4o-mini
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OLLAMA_LLM_MODEL=llama3.2
# OLLAMA_EMBED_MODEL=bge-m3
# OLLAMA_URL=http://localhost:11434

# Chunking dei CV: semantic (default) oppure headers
# CHUNKING=semantic
# CHUNK_BREAKPOINT_PERCENTILE=95

# Embedding: openai, ollama oppure local (SentenceTransformer, richiede: poetry install --with local)
# Se vuoto usa lo stesso provider della chat
# EMBEDDING_PROVIDER=ollama
# LOCAL_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
